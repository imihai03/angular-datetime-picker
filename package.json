{
    "name": "@imihai/angular-datetime-picker",
    "version": "22.2.3",
    "description": "Angular Date Time Picker",
    "license": "MIT",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build picker",
        "test": "ng test picker",
        "test:ci": "ng test --watch=false --no-progress --browsers=ChromeHeadlessCI --code-coverage=true picker",
        "lint": "eslint projects/picker/src src e2e/src playwright.config.ts",
        "e2e": "playwright test",
        "build_lib_onWindows": "ng build picker --configuration production",
        "build_lib_onLinux": "ng build picker --configuration production",
        "build_css_onWindows": "sass --style=compressed --no-source-map projects/picker/src/sass/picker.scss dist/picker/assets/style/picker.min.css",
        "build_css_onLinux": "sass --style=compressed --no-source-map projects/picker/src/sass/picker.scss dist/picker/assets/style/picker.min.css",
        "npm_pack": "cd dist/picker && npm pack",
        "package_windows": "npm run build_lib_onWindows && npm run build_css_onWindows && npm run npm_pack",
        "package_linux": "npm run build_lib_onLinux && npm run build_css_onLinux && npm run npm_pack",
        "e2e:ui": "playwright test --ui",
        "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.e2e.json",
        "test:demo": "ng test date-time-picker-app --watch=false --no-progress --browsers=ChromeHeadless"
    },
    "dependencies": {
        "@angular/cdk": "^22.2.3",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/platform-browser-dynamic": "^22.2.3",
        "@angular/router": "^22.2.3",
        "core-js": "^3.50.0",
        "luxon": "^3.7.2",
        "np": "^12.1.1",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.2.2",
        "@angular-eslint/eslint-plugin": "^22.6.0",
        "@angular-eslint/eslint-plugin-template": "^22.6.0",
        "@angular-eslint/schematics": "^22.6.0",
        "@angular-eslint/template-parser": "^22.6.0",
        "@angular/cli": "^22.2.2",
        "@types/luxon": "^3.7.6",
        "@angular/compiler-cli": "^22.2.3",
        "@angular/language-service": "^22.2.3",
        "@types/jasmine": "^5.1.9",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "codecov": "^3.8.3",
        "eslint": "^10.12.0",
        "jasmine-core": "~5.13.0",
        "karma": "~6.4.3",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "^2.3.0",
        "ng-packagr": "^22.2.4",
        "sass": "^1.105.1",
        "typescript": "~6.0.3",
        "@playwright/test": "1.64.0"
    },
    "overrides": {
        "@lmdb/lmdb-darwin-arm64": "3.0.12"
    },
    "optionalDependencies": {
        "@nx/nx-darwin-arm64": "21.5.3",
        "@nx/nx-darwin-x64": "21.5.3",
        "@nx/nx-linux-x64-gnu": "21.5.3",
        "@nx/nx-win32-x64-msvc": "21.5.3"
    }
}
